#!/bin/bash
remote="$1"
while read local_ref local_oid remote_ref remote_oid; do
    if [ "$remote_oid" = "0000000000000000000000000000000000000000" ]; then
        range="$local_oid"
    else
        range="$remote_oid..$local_oid"
    fi
    unsigned=$(git log --format='%H %G?' "$range" -- 2>/dev/null | grep ' N$' | wc -l)
    if [ "$unsigned" -gt 0 ]; then
        echo "ERROR: $unsigned unsigned commit(s). Sign before pushing:"
        echo "  git rebase --exec 'git commit --amend --no-edit -S' $remote_oid..$local_oid"
        exit 1
    fi
done
exit 0
